<?xml version="1.0" encoding="utf-8"?>
<!-- Plesk / IIS. dotnet publish bu dosyaya aspNetCore satırlarını kendisi ekler. -->
<configuration>
  <system.webServer>
    <!-- Blazor Server canlı bağlantısı (SignalR) WebSocket kullanır; kapalıysa daha yavaş yönteme düşer -->
    <webSocket enabled="true" />
    <security>
      <requestFiltering>
        <!-- 10 MB dosya sınırı + pay -->
        <requestLimits maxAllowedContentLength="12582912" />
      </requestFiltering>
    </security>
    <httpErrors errorMode="DetailedLocalOnly" />
    <directoryBrowse enabled="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Powered-By-Plesk" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
